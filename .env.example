PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://your-creator-studio-domain.example

# Optional production integrations
OPENAI_API_KEY=
ZERO_G_API_KEY=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
LLM_PROVIDER=0g
LLM_MODEL=MiniMax-M3
PROMPT_ENHANCEMENT=MiniMax-M3
TIER1_REPAIR_MODEL=glm-5
TIER3_REPAIR_MODEL=claude-fable-5
ZERO_G_ORCHESTRATOR_MODEL=glm-5.2
ZERO_G_CODING_MODEL=deepseek-v4-flash
ZERO_G_BACKGROUND_MODEL=deepseek-v4-flash
ZERO_G_IMAGE_MODEL=z-image-turbo
ZERO_G_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
ZERO_G_SPEECH_MODEL=openai/whisper-large-v3

# 0G Storage SDK. Keep the private key server-side only.
# Current sample endpoints are testnet. Use mainnet endpoints deliberately for production.
ZERO_G_STORAGE_ENABLED=true
ZERO_G_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_STORAGE_EVM_RPC=https://evmrpc-testnet.0g.ai
ZERO_G_STORAGE_PRIVATE_KEY=
ZERO_G_STORAGE_EXPECTED_REPLICA=1
ZERO_G_STORAGE_COLLECTION=zero_g_storage_objects

MONGODB_URI=mongodb://localhost:27017/prompt_creator_studio
MONGODB_COLLECTION=prompt_creator_studio
REDIS_URL=redis://localhost:6379

IPFS_API_URL=
IPFS_API_KEY=
IPFS_API_SECRET=

WEB3_PROVIDER_URL=
CONTRACT_ADDRESS=
ZERO_G_MAINNET_RPC_URL=https://evmrpc.0g.ai
ZERO_G_MAINNET_CHAIN_ID=16661

# Auth. Use a cryptographically random value, at least 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_DAYS=7
# Users sign in with their DogeOS wallet (DogeOS SDK). The wallet signs a
# server-issued challenge; no third-party auth secret is needed here.
APP_NAME=DogeGameLab

# DogeOS network (Chikyū testnet today; point at mainnet when it launches).
DOGEOS_CHAIN_ID=6281971
DOGEOS_RPC_URL=https://rpc.testnet.dogeos.com/
DOGEOS_EXPLORER_URL=https://dogeos-testnet.l2scan.co

# On-chain activity log. Every product action is logged to the
# DogeGameActivityLog contract on BOTH networks below (each is optional).
# Deploy with: node scripts/deployActivityLog.mjs 0g | dogeos
ZERO_G_ACTIVITY_ENABLED=true
ZERO_G_ACTIVITY_CONTRACT=
DOGEOS_ACTIVITY_ENABLED=true
DOGEOS_ACTIVITY_CONTRACT=
# Signer for DogeOS logs (needs test DOGE for gas). Falls back to ZERO_G_STORAGE_PRIVATE_KEY.
DOGEOS_ACTIVITY_PRIVATE_KEY=

PUBLIC_APP_URL=http://localhost:5173/studio
REFERRAL_BASE_URL=http://localhost:3001

# Referral security. Use random production-only values.
REFERRAL_ADMIN_KEY=
REFERRAL_IP_SALT=

# Generation is free. Each wallet gets this many games per tier
# (Fast = tier 1, Premium = tier 3). Editing is always free.
FREE_FAST_GENERATIONS=10
FREE_PREMIUM_GENERATIONS=1

# Per-tier free generation limits (subscription billing mode).
FREE_HYBRID_GENERATIONS=10
FREE_PRO_GENERATIONS=1
FREE_ULTRA_GENERATIONS=1

# Credits granted on Creator Plus purchase (first vs renewal).
PRO_FIRST_BUNDLE_PRO=15
PRO_FIRST_BUNDLE_ULTRA=10
PRO_FIRST_BUNDLE_HYBRID=0
PRO_RENEWAL_BUNDLE_PRO=20
PRO_RENEWAL_BUNDLE_ULTRA=0
PRO_RENEWAL_BUNDLE_HYBRID=10

# Credits granted on Creator Pro purchase.
ULTRA_BUNDLE_ULTRA=20
ULTRA_BUNDLE_HYBRID=10

# Cloudflare R2 (S3-compatible) - generated thumbnails and game sprites are
# stored here, public URLs are saved in MongoDB.
# Account ID: Cloudflare dashboard -> R2 -> Overview (right sidebar).
R2_ACCOUNT_ID=
# API token: R2 -> Manage API tokens -> Create API token (Object Read & Write),
# scoped to this bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name as created in R2.
R2_BUCKET=doge-lab
# Public base URL objects are served from: the bucket's r2.dev "Public
# Development URL", or a custom domain mapped to the bucket.
R2_PUBLIC_BASE=https://pub-5f00eb31584c43c0a8047a30007527d4.r2.dev
# Optional: folder path inside the bucket every upload is placed under.
R2_KEY_PREFIX=creator-studio
